// Fix #2 & #9: Firestore Security Rules
//
// Without these rules the Firebase project defaults to open access —
// anyone who extracts the client API key from the APK (trivial with
// apktool) can read or overwrite every shop's stock and sales data.
//
// Deploy with:  firebase deploy --only firestore:rules
// (Requires firebase-tools: npm install -g firebase-tools)
//
// These rules enforce that:
//  1. Only authenticated Firebase users can read or write any document.
//  2. A user can only access data under shops/{their own UID} — one shop
//     can never read or write another shop's stock, log, or settings.
//  3. The top-level /shops/{shopId} document (shop name, createdAt) is
//     readable only by its owner.
//  4. Everything else is denied.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Shop root document: name, createdAt
    match /shops/{shopId} {
      allow read, write: if request.auth != null && request.auth.uid == shopId;
    }

    // All sub-collections under a shop: stock, salesLog, pendingSales, settings
    match /shops/{shopId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == shopId;
    }

    // Deny everything not matched above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
